# Git에 포함하지 않을 로컬 생성 파일

# 패키지 의존성
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 테스트 결과
/coverage

# 웹 빌드 캐시
/.next/
/.vinext/
/out/

# 운영체제와 인증서 파일
.DS_Store
*.pem

# 패키지 관리자 오류 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 환경 변수 파일은 예시만 공개한다.
.env*
!.env.example

# 선택적 배포 도구 상태
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# 눈치숨 로컬 실행 데이터와 타입스크립트 증분 캐시
/data/
*.tsbuildinfo
