FROM node:24-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server ./server
COPY shared ./shared
COPY tsconfig.json ./tsconfig.json

RUN mkdir -p /app/data && chown -R node:node /app
USER node

EXPOSE 2567
CMD ["npm", "run", "start:server"]
